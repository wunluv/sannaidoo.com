---
interface Props {
  tag: string;
  title: string;
  price: string;
  description: string;
  features: string[];
}

const { tag, title, price, description, features } = Astro.props;
---

<div class="bg-surface dark:bg-[#1c1917] border border-border dark:border-[#292524] rounded-card p-6 md:p-8 hover:border-accent dark:hover:border-[#f59e0b] transition-colors">
  <p class="text-xs font-heading font-semibold uppercase tracking-widest text-accent dark:text-[#f59e0b]">{tag}</p>
  <h3 class="mt-2 font-heading font-bold text-xl md:text-2xl text-ink dark:text-[#fafaf9]">{title}</h3>
  <p class="mt-1 font-mono text-sm text-accent dark:text-[#f59e0b]">{price}</p>
  <p class="mt-3 text-ink/75 dark:text-[#d6d3d1] font-body text-base leading-relaxed">{description}</p>
  <ul class="mt-4 space-y-1.5">
    {features.map((feature) => (
      <li class="flex items-start gap-2 text-ink/70 dark:text-[#a8a29e] font-body text-base">
        <span class="text-accent dark:text-[#f59e0b] shrink-0">&rarr;</span>
        {feature}
      </li>
    ))}
  </ul>
</div>
