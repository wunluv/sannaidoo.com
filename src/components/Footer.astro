---
import TrustBadges from './TrustBadges.astro';
---

<footer class="border-t border-border dark:border-[#292524]">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <TrustBadges />

    <div class="mt-8 flex justify-center gap-6">
      <a href="https://linkedin.com/in/sannaidoo" class="text-sm font-heading font-medium text-muted dark:text-[#a8a29e] hover:text-accent dark:hover:text-[#f59e0b] transition-colors">LinkedIn</a>
      <a href="https://twitter.com/YOUR-HANDLE" class="text-sm font-heading font-medium text-muted dark:text-[#a8a29e] hover:text-accent dark:hover:text-[#f59e0b] transition-colors">Twitter</a>
    </div>

    <div class="mt-6 text-center space-y-2">
      <p class="text-sm text-muted dark:text-[#a8a29e] font-body">&copy; 2026 San Naidoo. All rights reserved.</p>
      <p class="text-xs text-muted/60 dark:text-[#a8a29e]/60 font-body">
        San Naidoo is a trading name of Khanyi Media Corporation (reg #3839662), Wilmington, Delaware.
      </p>
    </div>
  </div>
</footer>
