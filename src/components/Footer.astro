---
---

<section class="border-t border-border dark:border-[#292524] bg-bg dark:bg-[#0c0a09]">
  <div class="mx-auto max-w-3xl px-6 py-16">

    <!-- Trust & Partner Badges -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-items-center">

      <!-- PayPal Verified -->
      <div class="flex flex-col items-center gap-3 text-center">
        <img src="/paypal.jpeg" alt="PayPal Verified Business" class="h-14 w-auto rounded" />
        <p class="text-sm text-muted dark:text-[#a8a29e] font-body">Verified Business since 2005</p>
      </div>

      <!-- Stripe -->
      <div class="flex flex-col items-center gap-3 text-center">
        <div class="flex items-center gap-2">
          <img src="/Stripe_icon_-_square.svg" alt="Stripe" class="h-11 w-11 rounded" />
          <img src="/Stripe_wordmark.svg" alt="Stripe" class="h-6 w-auto" />
        </div>
        <p class="text-sm text-muted dark:text-[#a8a29e] font-body">Payments powered by Stripe</p>
      </div>

      <!-- Digital Ocean -->
      <div class="flex flex-col items-center gap-3 text-center">
        <img src="/DigitalOcean_logo.svg.png" alt="DigitalOcean" class="h-12 w-auto" />
        <p class="text-sm text-muted dark:text-[#a8a29e] font-body">Business partner since 2011</p>
      </div>

      <!-- Comodo Secured -->
      <div class="flex flex-col items-center gap-3 text-center">
        <img src="/comodo.png" alt="Comodo Secured" class="h-14 w-auto rounded" />
        <p class="text-sm text-muted dark:text-[#a8a29e] font-body">Secured by Comodo</p>
      </div>

    </div>

    <!-- Company Registration -->
    <div class="mt-12 pt-8 border-t border-border dark:border-[#292524] text-center">
      <p class="text-base text-muted dark:text-[#a8a29e] font-body">
        San Naidoo trades under <strong class="text-ink/80 dark:text-[#fafaf9]/80 font-heading">Khanyi Media</strong>
      </p>
      <p class="text-sm text-muted/70 dark:text-[#a8a29e]/70 font-body mt-2">
        Registered US Corp &middot; Reg #3839662 &middot; Wilmington, Delaware &middot; Trading since 2004
      </p>
    </div>

    <!-- Social Icons -->
    <div class="mt-8 flex justify-center gap-6">
      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/in/santhann/" class="text-muted dark:text-[#a8a29e] hover:text-accent dark:hover:text-[#f59e0b] transition-colors" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <!-- Twitter / X -->
      <a href="https://twitter.com/wunluv" class="text-muted dark:text-[#a8a29e] hover:text-accent dark:hover:text-[#f59e0b] transition-colors" aria-label="Twitter" target="_blank" rel="noopener">
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <!-- Email (spam-protected) -->
      <a href="#" class="text-muted dark:text-[#a8a29e] hover:text-accent dark:hover:text-[#f59e0b] transition-colors footer-email-link" aria-label="Email">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- Copyright -->
    <p class="mt-6 text-sm text-muted/50 dark:text-[#a8a29e]/50 font-body text-center">&copy; 2026 San Naidoo. All rights reserved.</p>
  </div>
</section>

<script>
  // Spam-protected email for footer icon
  const emailLink = document.querySelector('.footer-email-link');
  if (emailLink) {
    const user = 'san';
    const domain = 'khanyi.com';
    emailLink.href = `mailto:${user}@${domain}`;
  }
</script>
