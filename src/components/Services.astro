---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    tag: 'Starting Point',
    title: 'AI Clarity Call',
    description: "60 minutes to think through your idea and get honest answers. I'll break down what's technically feasible and what your next steps should be. Straight answers, no jargon.",
    features: [
      'Technical feasibility assessment',
      'Rough cost estimate (build + ongoing)',
      'Clear next steps, with me or without me',
    ],
  },
  {
    tag: 'Deep Engagement',
    title: 'AI Architecture Blueprint',
    description: 'A complete technical and business roadmap for your AI product. Not a vague proposal. A detailed blueprint any developer can execute.',
    features: [
      'Model selection and cost modeling at scale',
      'Full system architecture',
      'Implementation roadmap with timelines',
      'Build vs. buy analysis',
      'Revenue model recommendations',
      'Risk assessment and mitigation strategy',
    ],
  },
  {
    tag: 'For Committed Founders',
    title: 'AI Build Partnership',
    description: "I don't just plan it. I build it with you. Architecture, development, and ongoing advisory as a technical partner embedded in your team.",
    features: [
      'Hands-on development of core AI systems',
      'Weekly strategy sessions',
      'Direct access for real-time questions',
      'Iterative architecture as your product scales',
      'Limited to 2 to 3 concurrent partnerships',
    ],
  },
  {
    tag: 'Enterprise',
    title: 'Private AI Pipeline',
    description: "Fully private, compliant AI infrastructure for organizations that can't send data to public APIs. Healthcare, finance, legal, government.",
    features: [
      'Self-hosted model deployment',
      'Compliance-aligned pipeline design (POPIA, GDPR)',
      'Data governance framework',
      'Team training and documentation',
    ],
  },
];
---

<section id="services" class="py-16 border-t border-border dark:border-[#292524]">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-ink dark:text-[#fafaf9] mb-4">What I offer</h2>
    <p class="text-base md:text-lg text-ink/75 dark:text-[#d6d3d1] font-body max-w-xl mb-10">
      As an AI Systems Architect, my work sits between your knowledge and the technology. Every engagement is designed to move you from idea to production.
    </p>
    <div class="space-y-6">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </div>
</section>
